<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_cream">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_scrollFlags="scroll|enterAlways">

        <include
            android:id="@+id/appBarContent"
            layout="@layout/top_app_bar" />

    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        app:layout_behavior="@string/appbar_scrolling_view_behavior"
        android:paddingBottom="120dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/spacing_2xl">

            <!-- Title -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Your Loans"
                android:textAppearance="?attr/textAppearanceHeadlineSmall"
                android:textColor="@color/navy_text_primary"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xs"
                android:text="Monitor your active financing and review your successful repayment history."
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:textColor="@color/text_secondary" />

            <!-- Stats Overview -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xl"
                android:orientation="horizontal">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/activeBalanceCard"
                    style="@style/Widget.TerraLink.Card"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/card_padding">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="ACTIVE BALANCE"
                            android:textAppearance="?attr/textAppearanceLabelSmall"
                            android:textColor="@color/text_secondary"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/activeBalanceValue"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/spacing_sm"
                            android:text="KES 1,240.00"
                            android:textAppearance="?attr/textAppearanceHeadlineSmall"
                            android:textColor="@color/status_green"
                            android:textStyle="bold" />

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/nextPaymentCard"
                    style="@style/Widget.TerraLink.Card"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/card_padding">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="NEXT PAYMENT"
                            android:textAppearance="?attr/textAppearanceLabelSmall"
                            android:textColor="@color/text_secondary"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/nextPaymentValue"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/spacing_sm"
                            android:text="Oct 12"
                            android:textAppearance="?attr/textAppearanceHeadlineSmall"
                            android:textColor="@color/navy_text_primary"
                            android:textStyle="bold" />

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

            <!-- Active Loans Header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xl"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Active Loans"
                    android:textAppearance="?attr/textAppearanceTitleMedium"
                    android:textColor="@color/navy_text_primary"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/activeLoansCountBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@color/status_blue_bg"
                    android:paddingStart="@dimen/spacing_sm"
                    android:paddingTop="@dimen/spacing_xs"
                    android:paddingEnd="@dimen/spacing_sm"
                    android:paddingBottom="@dimen/spacing_xs"
                    android:text="2 Active"
                    android:textAppearance="?attr/textAppearanceLabelSmall"
                    android:textColor="@color/status_blue"
                    android:textStyle="bold" />

            </LinearLayout>

            <!-- Loan Card 1 (Active) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/loanCard1"
                style="@style/Widget.TerraLink.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_lg">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/card_padding">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/loan1Title"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="BUSINESS EXPANSION LOAN"
                                android:textAppearance="?attr/textAppearanceLabelSmall"
                                android:textColor="@color/terracotta_dark"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/loan1Id"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="ID: #MF-8829-21"
                                android:textAppearance="?attr/textAppearanceBodySmall"
                                android:textColor="@color/text_secondary" />

                        </LinearLayout>

                        <TextView
                            android:id="@+id/loan1PaidBadge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@color/status_green_bg"
                            android:paddingStart="@dimen/spacing_sm"
                            android:paddingTop="@dimen/spacing_xs"
                            android:paddingEnd="@dimen/spacing_sm"
                            android:paddingBottom="@dimen/spacing_xs"
                            android:text="Paid: 65%"
                            android:textAppearance="?attr/textAppearanceLabelSmall"
                            android:textColor="@color/status_green"
                            android:textStyle="bold" />

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_lg"
                        android:gravity="bottom"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/loan1AmountValue"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="KES 850.00 / KES 1,500.00"
                            android:textAppearance="?attr/textAppearanceHeadlineSmall"
                            android:textColor="@color/navy_text_primary"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/loan1MonthsLeft"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="4 months left"
                            android:textAppearance="?attr/textAppearanceBodySmall"
                            android:textColor="@color/text_secondary" />

                    </LinearLayout>

                    <ProgressBar
                        android:id="@+id/loan1Progress"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent"
                        android:layout_height="8dp"
                        android:layout_marginTop="@dimen/spacing_sm"
                        android:max="100"
                        android:progress="65"
                        android:progressTint="@color/terracotta_primary"
                        android:progressBackgroundTint="@color/terracotta_container" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_lg"
                        android:orientation="horizontal">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/loan1PayButton"
                            style="@style/Widget.TerraLink.Button.Primary"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Pay Installment" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/loan1DetailsButton"
                            style="@style/Widget.TerraLink.Button.Outlined"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="16dp"
                            android:text="Details" />

                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Loan Card 2 (Pending / Due) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/loanCard2"
                style="@style/Widget.TerraLink.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_lg">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/card_padding">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/loan2Title"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="AGRICULTURAL EQUIPMENT"
                                android:textAppearance="?attr/textAppearanceLabelSmall"
                                android:textColor="@color/terracotta_dark"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/loan2Id"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="ID: #MF-9012-05"
                                android:textAppearance="?attr/textAppearanceBodySmall"
                                android:textColor="@color/text_secondary" />

                        </LinearLayout>

                        <TextView
                            android:id="@+id/loan2DueBadge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@color/status_red_bg"
                            android:paddingStart="@dimen/spacing_sm"
                            android:paddingTop="@dimen/spacing_xs"
                            android:paddingEnd="@dimen/spacing_sm"
                            android:paddingBottom="@dimen/spacing_xs"
                            android:text="Due Today"
                            android:textAppearance="?attr/textAppearanceLabelSmall"
                            android:textColor="@color/status_red"
                            android:textStyle="bold" />

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_lg"
                        android:gravity="bottom"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/loan2AmountValue"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="KES 390.00 / KES 2,000.00"
                            android:textAppearance="?attr/textAppearanceHeadlineSmall"
                            android:textColor="@color/navy_text_primary"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/loan2MonthsLeft"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="12 months left"
                            android:textAppearance="?attr/textAppearanceBodySmall"
                            android:textColor="@color/text_secondary" />

                    </LinearLayout>

                    <ProgressBar
                        android:id="@+id/loan2Progress"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent"
                        android:layout_height="8dp"
                        android:layout_marginTop="@dimen/spacing_sm"
                        android:max="100"
                        android:progress="20"
                        android:progressTint="@color/status_red"
                        android:progressBackgroundTint="@color/status_red_bg" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_lg"
                        android:orientation="horizontal">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/loan2PayButton"
                            style="@style/Widget.TerraLink.Button.Primary"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Pay Now" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/loan2DetailsButton"
                            style="@style/Widget.TerraLink.Button.Outlined"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="16dp"
                            android:text="Details" />

                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Loan History -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xl"
                android:text="Loan History"
                android:textAppearance="?attr/textAppearanceTitleMedium"
                android:textColor="@color/navy_text_primary"
                android:textStyle="bold" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/historyItem1"
                style="@style/Widget.TerraLink.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_lg"
                android:alpha="0.9">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="@dimen/card_padding">

                    <ImageView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@color/olive_container"
                        android:contentDescription="Completed"
                        android:padding="10dp"
                        android:src="@drawable/ic_check_circle"
                        app:tint="@color/olive_secondary" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/spacing_lg"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/history1Title"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Emergency Medical Loan"
                            android:textAppearance="?attr/textAppearanceBodyLarge"
                            android:textColor="@color/navy_text_primary"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/history1Date"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Completed Aug 2023"
                            android:textAppearance="?attr/textAppearanceBodySmall"
                            android:textColor="@color/text_secondary" />

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="end"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/history1Amount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="KES 500.00"
                            android:textAppearance="?attr/textAppearanceBodyLarge"
                            android:textColor="@color/navy_text_primary"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/history1Status"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Closed"
                            android:textAppearance="?attr/textAppearanceBodySmall"
                            android:textColor="@color/terracotta_dark"
                            android:textStyle="bold" />

                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/historyItem2"
                style="@style/Widget.TerraLink.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_lg"
                android:alpha="0.9">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="@dimen/card_padding">

                    <ImageView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@color/olive_container"
                        android:contentDescription="Completed"
                        android:padding="10dp"
                        android:src="@drawable/ic_check_circle"
                        app:tint="@color/olive_secondary" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/spacing_lg"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/history2Title"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Seed Capital Loan"
                            android:textAppearance="?attr/textAppearanceBodyLarge"
                            android:textColor="@color/navy_text_primary"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/history2Date"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Completed Jan 2023"
                            android:textAppearance="?attr/textAppearanceBodySmall"
                            android:textColor="@color/text_secondary" />

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="end"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/history2Amount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="KES 1,200.00"
                            android:textAppearance="?attr/textAppearanceBodyLarge"
                            android:textColor="@color/navy_text_primary"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/history2Status"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Closed"
                            android:textAppearance="?attr/textAppearanceBodySmall"
                            android:textColor="@color/terracotta_dark"
                            android:textStyle="bold" />

                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <include
        android:id="@+id/loadingView"
        layout="@layout/layout_loading_error" />

    <com.google.android.material.bottomappbar.BottomAppBar
        android:id="@+id/bottomAppBar"
        style="@style/Widget.MaterialComponents.BottomAppBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@color/surface_card"
        app:fabAlignmentMode="center"
        app:fabCradleMargin="@dimen/fab_cradle_margin"
        app:fabCradleRoundedCornerRadius="@dimen/fab_cradle_radius"
        app:fabCradleVerticalOffset="@dimen/fab_cradle_offset">

        <com.google.android.material.bottomnavigation.BottomNavigationView
            android:id="@+id/bottomNavigationView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@android:color/transparent"
            app:itemIconTint="@color/selector_nav_color"
            app:itemTextColor="@color/selector_nav_color"
            app:labelVisibilityMode="labeled"
            app:menu="@menu/borrower_navigation_menu" />
    </com.google.android.material.bottomappbar.BottomAppBar>

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabNewAction"
        android:layout_width="@dimen/fab_size"
        android:layout_height="@dimen/fab_size"
        app:backgroundTint="@color/terralink_button_primary"
        app:layout_anchor="@id/bottomAppBar"
        app:layout_anchorGravity="center"
        app:maxImageSize="@dimen/button_icon_size"
        app:srcCompat="@android:drawable/ic_input_add"
        app:tint="@color/surface_card" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
