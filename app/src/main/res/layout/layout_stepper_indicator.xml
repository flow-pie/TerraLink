<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <TextView
        android:id="@+id/step1Indicator"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:background="@drawable/bg_stepper_active"
        android:gravity="center"
        android:text="1"
        android:textColor="@color/on_terracotta"
        android:textAppearance="?attr/textAppearanceBodySmall"
        android:textStyle="bold" />

    <View
        android:id="@+id/step1Line"
        android:layout_width="0dp"
        android:layout_height="3dp"
        android:layout_weight="1"
        android:background="@color/stepper_track" />

    <TextView
        android:id="@+id/step2Indicator"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:background="@drawable/bg_stepper_inactive"
        android:gravity="center"
        android:text="2"
        android:textColor="@color/text_secondary"
        android:textAppearance="?attr/textAppearanceBodySmall"
        android:textStyle="bold" />

    <View
        android:id="@+id/step2Line"
        android:layout_width="0dp"
        android:layout_height="3dp"
        android:layout_weight="1"
        android:background="@color/stepper_track" />

    <TextView
        android:id="@+id/step3Indicator"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:background="@drawable/bg_stepper_inactive"
        android:gravity="center"
        android:text="3"
        android:textColor="@color/text_secondary"
        android:textAppearance="?attr/textAppearanceBodySmall"
        android:textStyle="bold" />

    <View
        android:id="@+id/step3Line"
        android:layout_width="0dp"
        android:layout_height="3dp"
        android:layout_weight="1"
        android:background="@color/stepper_track" />

    <TextView
        android:id="@+id/step4Indicator"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:background="@drawable/bg_stepper_inactive"
        android:gravity="center"
        android:text="4"
        android:textColor="@color/text_secondary"
        android:textAppearance="?attr/textAppearanceBodySmall"
        android:textStyle="bold" />

    <View
        android:id="@+id/step4Line"
        android:layout_width="0dp"
        android:layout_height="3dp"
        android:layout_weight="1"
        android:background="@color/stepper_track" />

    <TextView
        android:id="@+id/step5Indicator"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:background="@drawable/bg_stepper_inactive"
        android:gravity="center"
        android:text="5"
        android:textColor="@color/text_secondary"
        android:textAppearance="?attr/textAppearanceBodySmall"
        android:textStyle="bold" />

</LinearLayout>