<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_cream">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <include
            android:id="@+id/appBarContent"
            layout="@layout/top_app_bar_back" />

    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/spacing_2xl"
            android:paddingTop="@dimen/spacing_2xl"
            android:paddingBottom="40dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="New Income Assessment"
                android:textAppearance="?attr/textAppearanceHeadlineSmall"
                android:textColor="@color/navy_text_primary"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xs"
                android:text="Provide your latest financial details to recalculate your credit score."
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:textColor="@color/text_secondary" />

            <!-- Business Revenue -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xl"
                android:text="BUSINESS REVENUE (MONTHLY)"
                android:textAppearance="?attr/textAppearanceLabelSmall"
                android:textColor="@color/navy_text_primary"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/revenueInput"
                android:layout_width="match_parent"
                android:layout_height="@dimen/input_height"
                android:layout_marginTop="@dimen/spacing_sm"
                android:background="@drawable/bg_input_background"
                android:hint="Enter monthly revenue"
                android:inputType="numberDecimal"
                android:paddingStart="@dimen/card_padding"
                android:paddingEnd="@dimen/card_padding"
                android:textColor="@color/navy_text_primary"
                android:textSize="14sp" />

            <!-- Household Expenses -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_lg"
                android:text="HOUSEHOLD EXPENSES (MONTHLY)"
                android:textAppearance="?attr/textAppearanceLabelSmall"
                android:textColor="@color/navy_text_primary"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/expensesInput"
                android:layout_width="match_parent"
                android:layout_height="@dimen/input_height"
                android:layout_marginTop="@dimen/spacing_sm"
                android:background="@drawable/bg_input_background"
                android:hint="Enter monthly expenses"
                android:inputType="numberDecimal"
                android:paddingStart="@dimen/card_padding"
                android:paddingEnd="@dimen/card_padding"
                android:textColor="@color/navy_text_primary"
                android:textSize="14sp" />

            <!-- Other Income -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_lg"
                android:text="OTHER INCOME (MONTHLY)"
                android:textAppearance="?attr/textAppearanceLabelSmall"
                android:textColor="@color/navy_text_primary"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/otherIncomeInput"
                android:layout_width="match_parent"
                android:layout_height="@dimen/input_height"
                android:layout_marginTop="@dimen/spacing_sm"
                android:background="@drawable/bg_input_background"
                android:hint="Enter other income"
                android:inputType="numberDecimal"
                android:paddingStart="@dimen/card_padding"
                android:paddingEnd="@dimen/card_padding"
                android:textColor="@color/navy_text_primary"
                android:textSize="14sp" />

            <!-- Submit Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSubmitAssessment"
                style="@style/Widget.TerraLink.Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="@dimen/button_min_height"
                android:layout_marginTop="@dimen/spacing_2xl"
                android:text="Submit Assessment" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
