<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_sheet"
    android:orientation="vertical"
    android:padding="24dp">

    <!-- Top Drag Handle -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:background="@color/surface_stroke" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="16dp"
        android:text="Confirm Payment"
        android:textColor="@color/navy_text_primary"
        android:textAppearance="?attr/textAppearanceHeadlineSmall"
        android:textStyle="bold" />

    <!-- Loan Summary Card -->
    <com.google.android.material.card.MaterialCardView
        style="@style/Widget.TerraLink.Card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="LOAN SUMMARY"
                    android:textColor="@color/text_secondary"
                    android:textAppearance="?attr/textAppearanceLabelSmall"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:background="@drawable/bg_status_badge_red"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="2dp"
                    android:text="Overdue: 2 Days"
                    android:textColor="@color/status_red"
                    android:textAppearance="?attr/textAppearanceLabelSmall"
                    android:textStyle="bold" />
            </RelativeLayout>

            <TextView
                android:id="@+id/tvRemainingBalance"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="KSh 42,500.00"
                android:textColor="@color/navy_text_primary"
                android:textAppearance="?attr/textAppearanceHeadlineSmall"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Remaining Balance"
                android:textColor="@color/text_secondary"
                android:textAppearance="?attr/textAppearanceBodyMedium" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Next Due" android:textColor="@color/text_secondary" android:textAppearance="?attr/textAppearanceLabelSmall" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="15 Oct 2023" android:textColor="@color/navy_text_primary" android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Installment" android:textColor="@color/text_secondary" android:textAppearance="?attr/textAppearanceLabelSmall" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="KSh 4,250.00" android:textColor="@color/navy_text_primary" android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Payment Amount -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="PAYMENT AMOUNT (KSH)"
        android:textColor="@color/navy_text_primary"
        android:textAppearance="?attr/textAppearanceLabelSmall"
        android:textStyle="bold" />

    <com.google.android.material.textfield.TextInputLayout
        style="@style/Widget.TerraLink.TextInputLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etPaymentAmount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="numberDecimal"
            android:text="KSh 4250.00"
            android:textStyle="bold" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- M-Pesa Phone Number -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="M-PESA PHONE NUMBER"
        android:textColor="@color/navy_text_primary"
        android:textAppearance="?attr/textAppearanceLabelSmall"
        android:textStyle="bold" />

    <com.google.android.material.textfield.TextInputLayout
        style="@style/Widget.TerraLink.TextInputLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        app:startIconDrawable="@drawable/ic_smartphone">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etMpesaPhone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="phone"
            android:text="0712 345 678" />
    </com.google.android.material.textfield.TextInputLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="A push notification will be sent to this device"
        android:textColor="@color/text_muted"
        android:textAppearance="?attr/textAppearanceBodySmall" />

    <!-- Presets (Full Balance, Installment, Custom) -->
    <com.google.android.material.chip.ChipGroup
        android:id="@+id/chipGroupAmount"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        app:singleSelection="true">

        <com.google.android.material.chip.Chip
            android:id="@+id/chipFullBalance"
            style="@style/Widget.Material3.Chip.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Full Balance" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chipInstallment"
            style="@style/Widget.Material3.Chip.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checked="true"
            android:text="Installment" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chipCustom"
            style="@style/Widget.Material3.Chip.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Custom" />
    </com.google.android.material.chip.ChipGroup>

    <!-- Pay Now Button (Green M-Pesa style) -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnPayMpesa"
        style="@style/Widget.TerraLink.Button.Primary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:backgroundTint="#2EAA43"
        android:text="Pay Now"
        app:icon="@drawable/ic_banknote" />

</LinearLayout>