<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Base.Theme.TerraLink" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/terracotta_primary</item>
        <item name="colorOnPrimary">@color/on_terracotta</item>
        <item name="colorPrimaryContainer">@color/terracotta_container</item>
        <item name="colorSecondary">@color/olive_secondary</item>
        <item name="android:colorBackground">#121212</item>
        <item name="colorSurface">#1E1E1E</item>
        <item name="colorOnSurface">#E0E0E0</item>
        <item name="colorError">@color/status_red</item>
        <item name="android:statusBarColor">#121212</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:navigationBarColor">#1E1E1E</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">false</item>
    </style>
    <style name="Theme.TerraLink.Dialog" parent="Base.Theme.TerraLink">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:backgroundDimEnabled">false</item>
    </style>
</resources>
