<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_cream">

    <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingStart="12dp"
    android:paddingEnd="12dp">

        <!-- Top Stepper Indicator (1, 2, 3) -->
        <include
            android:id="@+id/stepperHeader"
            layout="@layout/layout_stepper_indicator"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="24dp"
            android:layout_marginTop="20dp" />

        <!-- Error Banner View (Shown on validation failures) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardErrorBanner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp"
            android:layout_marginTop="12dp"
            android:visibility="gone"
            app:cardBackgroundColor="@color/status_red_bg"
            app:cardCornerRadius="12dp"
            app:strokeColor="@color/status_red"
            app:strokeWidth="1dp"
            tools:visibility="visible">

            <TextView
                android:id="@+id/tvErrorBanner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="14dp"
                android:text="Two fields need attention before this client can move to the next step."
                android:textColor="@color/status_red"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textStyle="bold" />
        </com.google.android.material.card.MaterialCardView>

        <!-- Dynamic Container for Step 1 (Personal Info), Step 2 (Address/Group), Step 3 (KYC), Step 4 (Review) -->
        <FrameLayout
            android:id="@+id/stepFragmentContainer"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:padding="12dp" />

        <!-- Bottom Action Bar (Previous / Next Buttons) -->
        <LinearLayout
            android:id="@+id/layoutBottomActions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/bg_cream"
            android:orientation="horizontal"
            android:padding="16dp"
            android:elevation="4dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPreviousStep"
                style="@style/Widget.TerraLink.Button.Outlined"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="12dp"
                android:layout_weight="1"
                android:text="PREVIOUS"
                android:visibility="gone"
                tools:visibility="visible" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnNextStep"
                style="@style/Widget.TerraLink.Button.Primary"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="NEXT STEP" />
        </LinearLayout>

    </LinearLayout>

    <include
        android:id="@+id/loadingView"
        layout="@layout/layout_loading_error" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>