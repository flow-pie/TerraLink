<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_sheet"
    android:orientation="vertical"
    android:padding="@dimen/spacing_2xl">

    <!-- Top Drag Handle -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:background="@color/surface_stroke"
        android:layout_marginBottom="@dimen/spacing_lg" />

    <!-- Toolbar/Header -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/spacing_lg">

        <ImageButton
            android:id="@+id/btnClose"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_chevron_right"
            android:rotation="90"
            app:tint="@color/navy_text_primary" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:text="Loan Appraisal"
            android:textAppearance="?attr/textAppearanceHeadlineSmall"
            android:textColor="@color/navy_text_primary"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/btnNotifications"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_alignParentEnd="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_bell"
            app:tint="@color/navy_text_primary" />
    </RelativeLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="500dp"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Pending Verification Banner -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardPendingVerification"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:visibility="gone"
                app:cardBackgroundColor="@color/status_amber_bg"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/status_amber"
                app:strokeWidth="1dp"
                tools:visibility="visible">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="12dp">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_warning"
                        app:tint="@color/status_amber" />

                    <TextView
                        android:id="@+id/tvPendingVerificationMsg"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:text="This client has pending assets/income for verification. Recalculate score after verifying."
                        android:textColor="@color/navy_text_primary"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnGoToScoring"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="VERIFY"
                        android:textColor="@color/status_amber"
                        android:textSize="11sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- LOAN APPLICATION SUMMARY CARD -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.TerraLink.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/card_padding">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tvAppId"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="APP ID: #LA-99283"
                            android:textAppearance="?attr/textAppearanceLabelSmall"
                            android:textColor="@color/terracotta_primary"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvAppStatus"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_status_badge_green"
                            android:paddingHorizontal="8dp"
                            android:paddingVertical="2dp"
                            android:text="PENDING APPRAISAL"
                            android:textAppearance="?attr/textAppearanceLabelSmall"
                            android:textColor="@color/status_green"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvClientName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Maina Wambui"
                        android:textAppearance="?attr/textAppearanceTitleLarge"
                        android:textColor="@color/navy_text_primary"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Amount"
                                android:textAppearance="?attr/textAppearanceLabelSmall"
                                android:textColor="@color/text_secondary" />

                            <TextView
                                android:id="@+id/tvLoanAmount"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="KES 45,000"
                                android:textAppearance="?attr/textAppearanceBodyLarge"
                                android:textColor="@color/navy_text_primary"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Duration"
                                android:textAppearance="?attr/textAppearanceLabelSmall"
                                android:textColor="@color/text_secondary" />

                            <TextView
                                android:id="@+id/tvLoanDuration"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="6 Months"
                                android:textAppearance="?attr/textAppearanceBodyLarge"
                                android:textColor="@color/navy_text_primary"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="Purpose"
                        android:textAppearance="?attr/textAppearanceLabelSmall"
                        android:textColor="@color/text_secondary" />

                    <TextView
                        android:id="@+id/tvLoanPurpose"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Poultry Farm Expansion"
                        android:textColor="@color/terracotta_primary"
                        android:textStyle="bold" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- CREDIT SCORE GAUGE CARD -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.TerraLink.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_lg">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:padding="@dimen/card_padding">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="CREDIT SCORE"
                        android:textAppearance="?attr/textAppearanceLabelSmall"
                        android:textColor="@color/terracotta_primary"
                        android:textStyle="bold" />

                    <com.terralink.ui.views.CreditScoreGaugeView
                        android:id="@+id/creditGaugeView"
                        android:layout_width="140dp"
                        android:layout_height="140dp"
                        android:layout_marginTop="8dp" />

                    <TextView
                        android:id="@+id/clientStatus"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="Score based on historical and group metrics."
                        android:textAppearance="?attr/textAppearanceBodySmall"
                        android:textColor="@color/text_muted" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="16dp"
                        android:background="@color/surface_stroke" />

                    <!-- Credit Score Breakdown -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:orientation="vertical">

                        <!-- Repayment History -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">
                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Repayment History"
                                android:textColor="@color/text_secondary"
                                android:textSize="12sp" />
                            <TextView
                                android:id="@+id/tvRepaymentHistoryScore"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                tools:text="7 / 40"
                                android:textColor="@color/navy_text_primary"
                                android:textStyle="bold"
                                android:textSize="12sp" />
                        </LinearLayout>
                        <ProgressBar
                            android:id="@+id/pbRepaymentHistory"
                            style="?android:attr/progressBarStyleHorizontal"
                            android:layout_width="match_parent"
                            android:layout_height="4dp"
                            android:layout_marginTop="4dp"
                            android:layout_marginBottom="12dp"
                            android:max="40"
                            android:progressTint="@color/terracotta_primary"
                            tools:progress="7" />

                        <!-- Repayment Capacity -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">
                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Repayment Capacity"
                                android:textColor="@color/text_secondary"
                                android:textSize="12sp" />
                            <TextView
                                android:id="@+id/tvRepaymentCapacityScore"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                tools:text="18 / 30"
                                android:textColor="@color/navy_text_primary"
                                android:textStyle="bold"
                                android:textSize="12sp" />
                        </LinearLayout>
                        <ProgressBar
                            android:id="@+id/pbRepaymentCapacity"
                            style="?android:attr/progressBarStyleHorizontal"
                            android:layout_width="match_parent"
                            android:layout_height="4dp"
                            android:layout_marginTop="4dp"
                            android:layout_marginBottom="12dp"
                            android:max="30"
                            android:progressTint="@color/status_blue"
                            tools:progress="18" />

                        <!-- Financial Stability -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">
                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Financial Stability"
                                android:textColor="@color/text_secondary"
                                android:textSize="12sp" />
                            <TextView
                                android:id="@+id/tvFinancialStabilityScore"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                tools:text="5 / 20"
                                android:textColor="@color/navy_text_primary"
                                android:textStyle="bold"
                                android:textSize="12sp" />
                        </LinearLayout>
                        <ProgressBar
                            android:id="@+id/pbFinancialStability"
                            style="?android:attr/progressBarStyleHorizontal"
                            android:layout_width="match_parent"
                            android:layout_height="4dp"
                            android:layout_marginTop="4dp"
                            android:layout_marginBottom="12dp"
                            android:max="20"
                            android:progressTint="@color/status_amber"
                            tools:progress="5" />

                        <!-- Verified Assets -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">
                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Verified Assets"
                                android:textColor="@color/text_secondary"
                                android:textSize="12sp" />
                            <TextView
                                android:id="@+id/tvVerifiedAssetsScore"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                tools:text="4 / 10"
                                android:textColor="@color/navy_text_primary"
                                android:textStyle="bold"
                                android:textSize="12sp" />
                        </LinearLayout>
                        <ProgressBar
                            android:id="@+id/pbVerifiedAssets"
                            style="?android:attr/progressBarStyleHorizontal"
                            android:layout_width="match_parent"
                            android:layout_height="4dp"
                            android:layout_marginTop="4dp"
                            android:max="10"
                            android:progressTint="@color/status_green"
                            tools:progress="4" />

                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ASSET INVENTORY -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.TerraLink.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_lg">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/card_padding">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Asset Inventory"
                        android:textAppearance="?attr/textAppearanceTitleMedium"
                        android:textColor="@color/navy_text_primary"
                        android:textStyle="bold" />

                    <com.google.android.flexbox.FlexboxLayout
                        android:id="@+id/assetFlexbox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        app:flexWrap="wrap"
                        app:justifyContent="flex_start" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- OFFICER FIELD TIP -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_lg"
                android:background="@drawable/bg_quick_action2_background"
                android:alpha="0.9"
                android:orientation="horizontal"
                android:padding="16dp">

                <View
                    android:layout_width="4dp"
                    android:layout_height="match_parent"
                    android:background="@color/on_terracotta" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="OFFICER'S APPRAISAL TIP"
                        android:textAppearance="?attr/textAppearanceLabelSmall"
                        android:textColor="@color/on_terracotta"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvFieldTip"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Check the client credit score. High credit score correlates strongly with yield."
                        android:textAppearance="?attr/textAppearanceBodySmall"
                        android:textColor="@color/on_terracotta" />
                </LinearLayout>
            </LinearLayout>

            <!-- REPAYMENT HISTORY -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.TerraLink.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_lg">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/card_padding">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Repayment History"
                        android:textAppearance="?attr/textAppearanceTitleMedium"
                        android:textColor="@color/navy_text_primary"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:id="@+id/repaymentHistoryContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="vertical" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- DECISION NOTES -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_lg"
                android:text="DECISION NOTES"
                android:textAppearance="?attr/textAppearanceLabelSmall"
                android:textColor="@color/navy_text_primary"
                android:textStyle="bold" />

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.TerraLink.TextInputLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_sm">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etDecisionNotes"
                    android:layout_width="match_parent"
                    android:layout_height="120dp"
                    android:gravity="top"
                    android:hint="Add appraisal summary..."
                    android:inputType="textMultiLine"
                    android:textColor="@color/navy_text_primary" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- ACTION BUTTONS -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSubmitApproval"
                style="@style/Widget.TerraLink.Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xl"
                android:text="Approve Application"
                app:icon="@drawable/ic_check_circle" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_md"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnInfoRequest"
                    style="@style/Widget.TerraLink.Button.Outlined"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    android:text="Info Request"
                    android:textSize="12sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnRejectAppraisal"
                    style="@style/Widget.TerraLink.Button.Dark"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:text="Reject"
                    android:textSize="12sp"
                    app:backgroundTint="@color/status_red" />

            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</LinearLayout>
