<resources xmlns:tools="http://schemas.android.com/tools">
    <!--  Base Material 3 Application Theme  -->
    <style name="Theme.TerraLink" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/terracotta_primary</item>
        <item name="colorOnPrimary">@color/on_terracotta</item>
        <item name="colorPrimaryContainer">@color/terracotta_container</item>
        <item name="colorSecondary">@color/olive_secondary</item>
        <item name="android:colorBackground">@color/bg_cream</item>
        <item name="colorSurface">@color/surface_card</item>
        <item name="colorOnSurface">@color/navy_text_primary</item>
        <item name="colorError">@color/status_red</item>
        <!--  Status bar styling  -->
        <item name="android:statusBarColor">@color/bg_cream</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:navigationBarColor">@color/surface_card</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">true</item>
    </style>
    <!--  Primary Action Button (Terracotta)  -->
    <style name="Widget.TerraLink.Button.Primary" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/terralink_button_primary</item>
        <item name="android:textColor">@color/on_terracotta</item>
        <item name="cornerRadius">14dp</item>
        <item name="android:minHeight">54dp</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.02</item>
    </style>
    <!--  Secondary Outline Button  -->
    <style name="Widget.TerraLink.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="strokeColor">@color/terracotta_primary</item>
        <item name="strokeWidth">1.5dp</item>
        <item name="android:textColor">@color/terracotta_primary</item>
        <item name="cornerRadius">14dp</item>
        <item name="android:minHeight">54dp</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
    </style>
    <!--  Dark Charcoal Button  -->
    <style name="Widget.TerraLink.Button.Dark" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/navy_dark</item>
        <item name="android:textColor">@color/on_terracotta</item>
        <item name="cornerRadius">14dp</item>
        <item name="android:minHeight">54dp</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
    </style>
    <!--  Outline Text Input  -->
    <style name="Widget.TerraLink.TextInputLayout" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxStrokeColor">@color/terracotta_primary</item>
        <item name="boxCornerRadiusTopStart">12dp</item>
        <item name="boxCornerRadiusTopEnd">12dp</item>
        <item name="boxCornerRadiusBottomStart">12dp</item>
        <item name="boxCornerRadiusBottomEnd">12dp</item>
        <item name="boxStrokeWidth">1dp</item>
        <item name="boxStrokeWidthFocused">2dp</item>
        <item name="boxBackgroundColor">@color/surface_card</item>
        <item name="hintTextColor">@color/text_secondary</item>
    </style>
    <!--  Material 3 Rounded Card Container  -->
    <style name="Widget.TerraLink.Card" parent="Widget.Material3.CardView.Elevated">
        <item name="cardBackgroundColor">@color/surface_card</item>
        <item name="cardCornerRadius">16dp</item>
        <item name="strokeColor">@color/surface_stroke</item>
        <item name="strokeWidth">1dp</item>
    </style>
    <style name="TerraLink.Table" parent=""/>
    <style name="TerraLink.Table.Label">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">#7A6A63</item>
        <item name="android:textSize">12sp</item>
        <item name="android:fontFamily">monospace</item>
    </style>
    <style name="TerraLink.Table.Value">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">4dp</item>
        <item name="android:textColor">@color/navy_text_primary</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="TerraLink.Table.Header">
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">#53433D</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">monospace</item>
    </style>
    <style name="ShapeAppearanceOverlay.Circle" parent="ShapeAppearance.Material3.Corner.Full"/>
</resources>