<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_cream">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <include
            android:id="@+id/appBarContent"
            layout="@layout/top_app_bar_back" />

    </com.google.android.material.appbar.AppBarLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <!-- Stepper Indicator -->
        <include
            android:id="@+id/layoutStepper"
            layout="@layout/layout_stepper_indicator"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="24dp"
            android:layout_marginTop="20dp" />

        <androidx.core.widget.NestedScrollView
            android:id="@+id/nestedScrollView"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingBottom="40dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="24dp"
                android:paddingTop="24dp">

                <!-- STEP 1: PRODUCT SELECTION -->
                <LinearLayout
                    android:id="@+id/layoutStep1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="visible">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Choose Loan Product"
                        android:textAppearance="?attr/textAppearanceTitleLarge"
                        android:textColor="@color/navy_text_primary"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Select a financing option that fits your current business needs."
                        android:textAppearance="?attr/textAppearanceBodySmall"
                        android:textColor="@color/text_secondary" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rvLoanProducts"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        tools:listitem="@layout/item_loan_product_card" />

                </LinearLayout>

                <!-- STEP 2: AMOUNT & TENURE -->
                <LinearLayout
                    android:id="@+id/layoutStep2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone"
                    tools:visibility="gone">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Customize Your Loan"
                        android:textAppearance="?attr/textAppearanceTitleLarge"
                        android:textColor="@color/navy_text_primary"
                        android:textStyle="bold" />

                    <!-- Requested Amount -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="24dp"
                        android:text="HOW MUCH DO YOU NEED?"
                        android:textAppearance="?attr/textAppearanceLabelSmall"
                        android:textColor="@color/text_secondary"
                        android:textStyle="bold"
                        android:letterSpacing="0.05" />

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.TerraLink.TextInputLayout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        app:prefixText="KES ">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etRequestedAmount"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="numberDecimal"
                            android:text="25000"
                            android:textStyle="bold"
                            android:textSize="18sp" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:orientation="horizontal">
                        <TextView android:id="@+id/tvMinAmount" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" tools:text="Min: 5,000" android:textSize="11sp" />
                        <TextView android:id="@+id/tvMaxAmount" android:layout_width="wrap_content" android:layout_height="wrap_content" tools:text="Max: 500,000" android:textSize="11sp" />
                    </LinearLayout>

                    <!-- Tenure -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="24dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="REPAYMENT PERIOD"
                            android:textAppearance="?attr/textAppearanceLabelSmall"
                            android:textColor="@color/text_secondary"
                            android:textStyle="bold" />
                        <TextView
                            android:id="@+id/tvTenureDisplay"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            tools:text="6 Months"
                            android:textColor="@color/terracotta_primary"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <SeekBar
                        android:id="@+id/sbTenure"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:max="12"
                        android:min="1" />

                    <!-- Repayment Preview -->
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="32dp"
                        app:cardBackgroundColor="@color/olive_secondary"
                        app:cardCornerRadius="16dp"
                        app:cardElevation="4dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="20dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Repayment Preview"
                                android:textColor="@color/bg_cream"
                                android:textStyle="bold" />

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="16dp"
                                android:orientation="horizontal">
                                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Monthly Installment" android:textColor="#B3FFFFFF" android:textSize="13sp" />
                                <TextView android:id="@+id/tvMonthlyInstallment" android:layout_width="wrap_content" android:layout_height="wrap_content" tools:text="KES 4,500" android:textColor="@color/on_terracotta" android:textStyle="bold" />
                            </LinearLayout>

                            <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginVertical="12dp" android:background="#26FFFFFF" />

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal">
                                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Total Interest" android:textColor="#B3FFFFFF" android:textSize="13sp" />
                                <TextView android:id="@+id/tvTotalInterest" android:layout_width="wrap_content" android:layout_height="wrap_content" tools:text="KES 2,000" android:textColor="@color/on_terracotta" />
                            </LinearLayout>

                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                </LinearLayout>

                <!-- STEP 3: ELIGIBILITY CHECK RESULT -->
                <LinearLayout
                    android:id="@+id/layoutStep3"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <!-- ELIGIBLE VIEW -->
                    <LinearLayout
                        android:id="@+id/layoutEligible"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:background="@drawable/bg_eligible"
                        android:paddingStart="24dp"
                        android:paddingEnd="24dp"
                        android:paddingTop="20dp"
                        android:paddingBottom="24dp"
                        android:visibility="visible">

                        <!-- Celebration -->
                        <ImageView
                            android:id="@+id/imgCelebration"
                            android:layout_width="110dp"
                            android:layout_height="110dp"
                            android:layout_gravity="center_horizontal"
                            android:layout_marginTop="12dp"
                            android:contentDescription="Eligibility Success"
                            android:src="@drawable/ic_check_circle"
                            app:tint="@color/terracotta_primary" />

                        <!-- Small message -->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center_horizontal"
                            android:layout_marginTop="10dp"
                            android:text="That was too easy!"
                            android:textColor="@color/olive_secondary"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <!-- Main heading -->
                        <TextView
                            android:id="@+id/tvEligibleTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center_horizontal"
                            android:layout_marginTop="8dp"
                            android:text="You are eligible."
                            android:textColor="@color/status_green"
                            android:textSize="18sp"
                            android:textStyle="bold" />

                        <!-- Bank message -->
                        <TextView
                            android:id="@+id/tvEligibleMsg"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="14dp"
                            android:gravity="center"
                            android:text="Kindly allow 3-4hrs to reflect in your bank account"
                            android:textColor="@color/text_secondary"
                            android:textSize="12sp" />

                        <!-- Transaction Summary -->
                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="18dp"
                            app:cardBackgroundColor="@color/olive_secondary"
                            app:cardCornerRadius="12dp"
                            app:cardElevation="2dp">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:padding="18dp">

                                <!-- Summary title -->
                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:gravity="center"
                                    android:text="Transaction Summary"
                                    android:textColor="@color/on_terracotta"
                                    android:textSize="14sp"
                                    android:textStyle="bold" />

                                <View
                                    android:layout_width="match_parent"
                                    android:layout_height="1dp"
                                    android:layout_marginTop="10dp"
                                    android:background="#55FFFFFF" />

                                <include
                                    android:id="@+id/summaryProduct"
                                    layout="@layout/layout_summary_row" />

                                <include
                                    android:id="@+id/summaryAmount"
                                    layout="@layout/layout_summary_row" />

                                <include
                                    android:id="@+id/summaryTenure"
                                    layout="@layout/layout_summary_row" />

                                <include
                                    android:id="@+id/summaryMonthly"
                                    layout="@layout/layout_summary_row" />

                                <include
                                    android:id="@+id/summaryRate"
                                    layout="@layout/layout_summary_row" />

                                <include
                                    android:id="@+id/summaryTotal"
                                    layout="@layout/layout_summary_row" />

                            </LinearLayout>

                        </com.google.android.material.card.MaterialCardView>

                        <!-- Terms -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="14dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <CheckBox
                                android:id="@+id/checkTerms"
                                android:layout_width="40dp"
                                android:layout_height="40dp"
                                android:buttonTint="@color/terracotta_primary" />

                            <TextView
                                android:id="@+id/tvTerms"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="I agree to the Terms &amp; Conditions and Policy."
                                android:textColor="@color/text_secondary"
                                android:textSize="11sp" />

                        </LinearLayout>

                    </LinearLayout>

                    <!-- NOT ELIGIBLE VIEW -->
                    <LinearLayout
                        android:id="@+id/layoutNotEligible"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:background="@drawable/bg_not_eligible"
                        android:padding="24dp"
                        android:visibility="gone"
                        tools:visibility="gone">

                        <ImageView
                            android:id="@+id/imgNotEligible"
                            android:layout_width="100dp"
                            android:layout_height="100dp"
                            android:layout_gravity="center_horizontal"
                            android:src="@drawable/ic_warning"
                            app:tint="@android:color/white"
                            android:contentDescription="Not Eligible" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:gravity="center"
                            android:text="Sorry! You are not eligible."
                            android:textAppearance="?attr/textAppearanceTitleLarge"
                            android:textColor="@android:color/white"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvNotEligibleReason"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:gravity="center"
                            android:text="Your current credit score does not meet the minimum requirement for this loan product."
                            android:textColor="#E0E0E0"
                            android:textSize="14sp" />

                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="24dp"
                            app:cardBackgroundColor="@color/terracotta_container"
                            app:cardCornerRadius="12dp"
                            app:cardElevation="0dp">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:padding="16dp">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="How to improve eligibility:"
                                    android:textColor="@color/terracotta_primary"
                                    android:textStyle="bold" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="8dp"
                                    android:text="• Complete your Income Assessment\n• Verify your business assets\n• Repay any existing smaller loans on time\n•Try applying for a lower amount"
                                    android:textColor="@color/text_secondary"
                                    android:textSize="13sp" />
                            </LinearLayout>
                        </com.google.android.material.card.MaterialCardView>

                    </LinearLayout>

                </LinearLayout>

            </LinearLayout>

        </androidx.core.widget.NestedScrollView>

        <!-- Bottom Actions -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/surface_card"
            android:padding="20dp"
            android:elevation="8dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnActionBack"
                style="@style/Widget.TerraLink.Button.Outlined"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="12dp"
                android:text="BACK"
                android:visibility="gone"
                tools:visibility="visible" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnNext"
                style="@style/Widget.TerraLink.Button.Primary"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1.5"
                android:text="CONTINUE" />

        </LinearLayout>

    </LinearLayout>

    <include
        android:id="@+id/loadingView"
        layout="@layout/layout_loading_error" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
