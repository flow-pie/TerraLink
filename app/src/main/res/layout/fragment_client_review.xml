<?xml version="1.0" encoding="utf-8"?>
<!-- Step 4 – Review Client Details (Final Check). Source: Figma node 83:628 -->
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_cream"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Header -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="FINAL CHECK"
            android:textAllCaps="true"
            android:textColor="@color/terracotta_primary"
            android:textStyle="bold"
            android:letterSpacing="0.06"
            android:textSize="11sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="16dp"
            android:text="Review client details"
            android:textColor="@color/navy_text_primary"
            android:textStyle="bold"
            android:textSize="24sp" />

        <!-- Personal Information -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardBackgroundColor="@color/surface_card"
            app:cardCornerRadius="12dp"
            app:cardElevation="1dp"
            app:strokeColor="@color/surface_stroke"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@color/surface_card_subtle"
                    android:paddingHorizontal="14dp"
                    android:paddingTop="8dp"
                    android:paddingBottom="9dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Personal Information"
                        android:textColor="@color/terracotta_primary"
                        android:textStyle="bold"
                        android:textSize="15sp" />

                    <TextView
                        android:id="@+id/btnEditPersonalInfo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="EDIT"
                        android:textAllCaps="true"
                        android:textColor="@color/text_secondary"
                        android:textStyle="bold"
                        android:textSize="11sp"
                        android:padding="4dp"
                        android:clickable="true"
                        android:focusable="true" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="10dp">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="FULL NAME"
                                android:textAllCaps="true"
                                android:textColor="@color/text_secondary"
                                android:textStyle="bold"
                                android:letterSpacing="0.04"
                                android:textSize="10sp" />
                            <TextView
                                android:id="@+id/tvFullName"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Amina Wanjiku"
                                android:textColor="@color/navy_text_primary"
                                android:textStyle="bold"
                                android:textSize="14sp" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="PHONE"
                                android:textAllCaps="true"
                                android:textColor="@color/text_secondary"
                                android:textStyle="bold"
                                android:letterSpacing="0.04"
                                android:textSize="10sp" />
                            <TextView
                                android:id="@+id/tvPhone"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="+254 712 408 221"
                                android:textColor="@color/navy_text_primary"
                                android:textStyle="bold"
                                android:textSize="14sp" />
                        </LinearLayout>

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="GOVERNMENT ID"
                                android:textAllCaps="true"
                                android:textColor="@color/text_secondary"
                                android:textStyle="bold"
                                android:letterSpacing="0.04"
                                android:textSize="10sp" />
                            <TextView
                                android:id="@+id/tvGovernmentId"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="284-71-9032"
                                android:fontFamily="monospace"
                                android:textColor="@color/navy_text_primary"
                                android:textStyle="bold"
                                android:textSize="13sp" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="DATE OF BIRTH"
                                android:textAllCaps="true"
                                android:textColor="@color/text_secondary"
                                android:textStyle="bold"
                                android:letterSpacing="0.04"
                                android:textSize="10sp" />
                            <TextView
                                android:id="@+id/tvDateOfBirth"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="1988-04-17"
                                android:textColor="@color/navy_text_primary"
                                android:textStyle="bold"
                                android:textSize="14sp" />
                        </LinearLayout>

                    </LinearLayout>

                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Address & Group -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardBackgroundColor="@color/surface_card"
            app:cardCornerRadius="12dp"
            app:cardElevation="1dp"
            app:strokeColor="@color/surface_stroke"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@color/surface_card_subtle"
                    android:paddingHorizontal="14dp"
                    android:paddingTop="8dp"
                    android:paddingBottom="9dp"
                    android:text="Address &amp; Group"
                    android:textColor="@color/terracotta_primary"
                    android:textStyle="bold"
                    android:textSize="15sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="10dp">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="GROUP"
                                android:textAllCaps="true"
                                android:textColor="@color/text_secondary"
                                android:textStyle="bold"
                                android:letterSpacing="0.04"
                                android:textSize="10sp" />
                            <TextView
                                android:id="@+id/tvGroup"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Unity Cooperative A"
                                android:textColor="@color/navy_text_primary"
                                android:textStyle="bold"
                                android:textSize="14sp" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="REGION"
                                android:textAllCaps="true"
                                android:textColor="@color/text_secondary"
                                android:textStyle="bold"
                                android:letterSpacing="0.04"
                                android:textSize="10sp" />
                            <TextView
                                android:id="@+id/tvRegion"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="East Cluster"
                                android:textColor="@color/navy_text_primary"
                                android:textStyle="bold"
                                android:textSize="14sp" />
                        </LinearLayout>

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:background="@drawable/bg_status_badge_green"
                        android:padding="11dp">

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:layout_marginEnd="9dp"
                            android:src="@drawable/ic_help_circle"
                            app:tint="@color/terracotta_dark" />

                        <TextView
                            android:id="@+id/tvAddressNote"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Plot 45, Industrial Area, East Cluster — verified for first-time loan applicant intake."
                            android:textColor="@color/terracotta_dark"
                            android:textStyle="bold"
                            android:textSize="12sp" />

                    </LinearLayout>

                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- KYC Captures -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardBackgroundColor="@color/surface_card"
            app:cardCornerRadius="12dp"
            app:cardElevation="1dp"
            app:strokeColor="@color/surface_stroke"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@color/surface_card_subtle"
                    android:paddingHorizontal="14dp"
                    android:paddingTop="8dp"
                    android:paddingBottom="9dp"
                    android:text="KYC Captures"
                    android:textColor="@color/terracotta_primary"
                    android:textStyle="bold"
                    android:textSize="15sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="14dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginEnd="8dp"
                        android:orientation="vertical"
                        android:gravity="center_horizontal">
                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="match_parent"
                            android:layout_height="58dp"
                            app:cardCornerRadius="10dp"
                            app:strokeColor="@color/terracotta_primary"
                            app:strokeWidth="1dp">
                            <ImageView
                                android:id="@+id/imgIdFront"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:scaleType="centerCrop"
                                android:contentDescription="ID front capture" />
                        </com.google.android.material.card.MaterialCardView>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="5dp"
                            android:text="ID FRONT"
                            android:textAllCaps="true"
                            android:textColor="@color/terracotta_dark"
                            android:textStyle="bold"
                            android:textSize="9sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginHorizontal="4dp"
                        android:orientation="vertical"
                        android:gravity="center_horizontal">
                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="match_parent"
                            android:layout_height="58dp"
                            app:cardCornerRadius="10dp"
                            app:strokeColor="@color/terracotta_primary"
                            app:strokeWidth="1dp">
                            <ImageView
                                android:id="@+id/imgIdBack"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:scaleType="centerCrop"
                                android:contentDescription="ID back capture" />
                        </com.google.android.material.card.MaterialCardView>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="5dp"
                            android:text="ID BACK"
                            android:textAllCaps="true"
                            android:textColor="@color/terracotta_dark"
                            android:textStyle="bold"
                            android:textSize="9sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        android:orientation="vertical"
                        android:gravity="center_horizontal">
                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="match_parent"
                            android:layout_height="58dp"
                            app:cardCornerRadius="10dp"
                            app:strokeColor="@color/status_green"
                            app:strokeWidth="1dp">
                            <ImageView
                                android:id="@+id/imgFace"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:scaleType="centerCrop"
                                android:contentDescription="Face capture" />
                        </com.google.android.material.card.MaterialCardView>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="5dp"
                            android:text="FACE"
                            android:textAllCaps="true"
                            android:textColor="@color/status_green"
                            android:textStyle="bold"
                            android:textSize="9sp" />
                    </LinearLayout>

                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Validation status rows -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_status_badge_green"
            android:paddingHorizontal="13dp"
            android:paddingVertical="11dp"
            android:layout_marginBottom="8dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Required fields complete"
                android:textColor="@color/navy_text_primary"
                android:textStyle="bold"
                android:textSize="13sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PASS"
                android:textColor="@color/status_green"
                android:textStyle="bold"
                android:textSize="10sp" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_status_badge_green"
            android:paddingHorizontal="13dp"
            android:paddingVertical="11dp"
            android:layout_marginBottom="17dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Ready for secure upload"
                android:textColor="@color/navy_text_primary"
                android:textStyle="bold"
                android:textSize="13sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PASS"
                android:textColor="@color/status_green"
                android:textStyle="bold"
                android:textSize="10sp" />

        </LinearLayout>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>