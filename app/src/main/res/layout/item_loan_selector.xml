<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/loanCard"
    android:layout_width="220dp"
    android:layout_height="wrap_content"
    android:layout_marginEnd="12dp"
    app:cardCornerRadius="16dp"
    android:layout_gravity="center_horizontal"
    app:cardElevation="2dp"
    app:strokeWidth="2dp"
    app:strokeColor="@color/surface_stroke">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tvLoanNo"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="#MLF-0000"
                android:textAppearance="?attr/textAppearanceLabelSmall"
                android:textColor="@color/terracotta_primary"
                android:textStyle="bold" />

            <View
                android:id="@+id/indicatorStatus"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:background="@drawable/bg_notification_dot" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvLoanAmount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="KES 250,000"
            android:textAppearance="?attr/textAppearanceTitleLarge"
            android:textColor="@color/navy_text_primary"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="ACTIVE"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textColor="@color/text_secondary"
            android:textAllCaps="true" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
