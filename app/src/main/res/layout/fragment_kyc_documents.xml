<?xml version="1.0" encoding="utf-8"?>
<!-- Step 3 – KYC Capture (empty state). Source: Figma node 83:158 -->
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/surface_card"
            app:cardCornerRadius="16dp"
            app:cardElevation="1dp"
            app:strokeColor="@color/surface_stroke"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@color/surface_card_subtle"
                    android:paddingHorizontal="24dp"
                    android:paddingTop="16dp"
                    android:paddingBottom="17dp"
                    android:text="KYC Documents"
                    android:textColor="@color/terracotta_primary"
                    android:textAppearance="?attr/textAppearanceTitleMedium"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="24dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp"
                        android:textStyle="bold"
                        android:letterSpacing="0.1"
                        android:text="UPLOAD OR CAPTURE PHOTOS"
                        android:textAllCaps="true"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp" />

                    <!-- ID Front / ID Back row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="16dp">

                        <LinearLayout
                            android:id="@+id/btnCaptureIdFront"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginEnd="8dp"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:padding="18dp"
                            android:background="@drawable/bg_dashed_upload"
                            android:clickable="true"
                            android:focusable="true">

                            <ImageView
                                android:id="@+id/ivIdFront"
                                android:layout_width="match_parent"
                                android:layout_height="80dp"
                                android:layout_marginBottom="8dp"
                                android:scaleType="centerCrop"
                                android:visibility="gone" />

                            <ImageView
                                android:id="@+id/ivIdFrontPlaceholder"
                                android:layout_width="32dp"
                                android:layout_height="32dp"
                                android:layout_marginBottom="8dp"
                                android:src="@drawable/ic_badge_id"
                                app:tint="@color/terracotta_primary" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="ID FRONT"
                                android:textAllCaps="true"
                                android:textColor="@color/text_secondary"
                                android:textStyle="bold"
                                android:textSize="10sp" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/btnCaptureIdBack"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="8dp"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:padding="18dp"
                            android:background="@drawable/bg_dashed_upload"
                            android:clickable="true"
                            android:focusable="true">

                            <ImageView
                                android:id="@+id/ivIdBack"
                                android:layout_width="match_parent"
                                android:layout_height="80dp"
                                android:layout_marginBottom="8dp"
                                android:scaleType="centerCrop"
                                android:visibility="gone" />

                            <ImageView
                                android:id="@+id/ivIdBackPlaceholder"
                                android:layout_width="32dp"
                                android:layout_height="32dp"
                                android:layout_marginBottom="8dp"
                                android:src="@drawable/ic_badge_id"
                                app:tint="@color/terracotta_primary" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="ID BACK"
                                android:textAllCaps="true"
                                android:textColor="@color/text_secondary"
                                android:textStyle="bold"
                                android:textSize="10sp" />
                        </LinearLayout>

                    </LinearLayout>

                    <!-- Passport Photo -->
                    <LinearLayout
                        android:id="@+id/btnCapturePassportPhoto"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center"
                        android:padding="18dp"
                        android:background="@drawable/bg_dashed_upload"
                        android:clickable="true"
                        android:focusable="true">

                        <ImageView
                            android:id="@+id/ivPassport"
                            android:layout_width="80dp"
                            android:layout_height="80dp"
                            android:layout_marginEnd="12dp"
                            android:scaleType="centerCrop"
                            android:visibility="gone" />

                        <ImageView
                            android:id="@+id/ivPassportPlaceholder"
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:layout_marginEnd="12dp"
                            android:src="@drawable/ic_users"
                            app:tint="@color/terracotta_primary" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:letterSpacing="0.1"
                            android:text="CAPTURE PASSPORT PHOTO"
                            android:textAllCaps="true"
                            android:textColor="@color/text_secondary"
                            android:textStyle="bold"
                            android:textSize="12sp" />
                    </LinearLayout>

                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>