<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_bottom_sheet"
    android:paddingBottom="24dp">

    <!-- Drag handle -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="16dp"
        android:background="@color/surface_stroke" />

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="24dp"
        android:gravity="center_vertical">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvLoanTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                tools:text="Emergency Loan #ML-82"
                android:textAppearance="?attr/textAppearanceTitleLarge"
                android:textColor="@color/navy_text_primary"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvLoanSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                tools:text="Approved Apr 12 • 6 Months"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textColor="@color/text_secondary" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvStatusBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingHorizontal="10dp"
            android:paddingVertical="3dp"
            tools:text="ACTIVE"
            android:background="@drawable/bg_status_badge_green"
            android:textColor="@color/status_green"
            android:textStyle="bold"
            android:textSize="11sp" />
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:maxHeight="650dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="24dp">

            <!-- APPLICATION TIMELINE -->
            <LinearLayout
                android:id="@+id/layoutApplicationTimeline"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone"
                tools:visibility="visible">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Application Status"
                    android:textAppearance="?attr/textAppearanceTitleMedium"
                    android:textColor="@color/navy_text_primary"
                    android:textStyle="bold"
                    android:layout_marginBottom="16dp" />

                <include android:id="@+id/stepSubmitted" layout="@layout/layout_timeline_item" />
                <include android:id="@+id/stepReview" layout="@layout/layout_timeline_item" />
                <include android:id="@+id/stepApproval" layout="@layout/layout_timeline_item" />

            </LinearLayout>

            <!-- ACTIVE LOAN DETAILS -->
            <LinearLayout
                android:id="@+id/layoutActiveLoanDetails"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Repayment Overview Card -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="@color/bg_cream"
                    app:strokeColor="@color/surface_stroke"
                    app:strokeWidth="1dp"
                    app:cardCornerRadius="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:padding="20dp"
                        android:gravity="center_vertical">

                        <FrameLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content">
                            <com.google.android.material.progressindicator.CircularProgressIndicator
                                android:id="@+id/cpProgress"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                app:indicatorSize="80dp"
                                app:trackThickness="8dp"
                                app:trackColor="@color/surface_stroke"
                                app:indicatorColor="@color/status_green"
                                tools:progress="65" />
                            <TextView
                                android:id="@+id/tvProgressText"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                tools:text="65%"
                                android:textColor="@color/navy_text_primary"
                                android:textStyle="bold"
                                android:textSize="16sp" />
                        </FrameLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="24dp"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="TOTAL REPAID"
                                android:textAppearance="?attr/textAppearanceLabelSmall"
                                android:textColor="@color/text_secondary"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvRepaidValue"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                tools:text="KES 24,000"
                                android:textAppearance="?attr/textAppearanceTitleMedium"
                                android:textColor="@color/status_green"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvTotalValue"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                tools:text="out of KES 45,000"
                                android:textAppearance="?attr/textAppearanceBodySmall"
                                android:textColor="@color/text_muted" />

                        </LinearLayout>

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <GridLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:columnCount="2"
                    android:layout_marginTop="20dp">

                    <LinearLayout android:orientation="vertical" android:layout_columnWeight="1">
                        <TextView style="@style/TerraLink.Table.Label" android:text="Current Balance" />
                        <TextView android:id="@+id/tvBalanceValue" style="@style/TerraLink.Table.Value" tools:text="KES 21,000" />
                    </LinearLayout>

                    <LinearLayout android:orientation="vertical" android:layout_columnWeight="1" android:gravity="end">
                        <TextView style="@style/TerraLink.Table.Label" android:text="Interest Rate" />
                        <TextView android:id="@+id/tvInterestRate" style="@style/TerraLink.Table.Value" tools:text="12.5%" />
                    </LinearLayout>

                </GridLayout>

                <!-- Repayment Schedule -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Repayment Schedule"
                    android:textAppearance="?attr/textAppearanceTitleMedium"
                    android:textColor="@color/navy_text_primary"
                    android:textStyle="bold"
                    android:layout_marginTop="28dp" />

                <LinearLayout
                    android:id="@+id/repaymentScheduleContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="vertical" />

            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnMainAction"
                style="@style/Widget.TerraLink.Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:text="Make a Payment"
                app:icon="@drawable/ic_wallet" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</LinearLayout>
