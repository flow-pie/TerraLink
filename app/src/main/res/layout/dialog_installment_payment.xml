<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_sheet"
    android:orientation="vertical"
    android:padding="@dimen/spacing_2xl">

    <!-- Top Drag Handle -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:background="@color/surface_stroke"
        android:layout_marginBottom="@dimen/spacing_lg" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:text="Confirm Payment"
        android:textAppearance="?attr/textAppearanceHeadlineSmall"
        android:textColor="@color/navy_text_primary"
        android:textStyle="bold" />

    <!-- Loan Summary Card -->
    <com.google.android.material.card.MaterialCardView
        style="@style/Widget.TerraLink.Card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_lg">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/card_padding">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="LOAN SUMMARY"
                    android:textAppearance="?attr/textAppearanceLabelSmall"
                    android:textColor="@color/text_secondary"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:background="@drawable/bg_status_badge_red"
                    android:layout_marginStart="8dp"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="2dp"
                    android:text="Overdue: 2 Days"
                    android:textAppearance="?attr/textAppearanceLabelSmall"
                    android:textColor="@color/status_red"
                    android:textStyle="bold" />

            </LinearLayout>

            <TextView
                android:id="@+id/tvRemainingBalance"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="KSh 42,500.00"
                android:textAppearance="?attr/textAppearanceHeadlineSmall"
                android:textColor="@color/navy_text_primary"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Remaining Balance"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:textColor="@color/text_secondary" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Next Due"
                        android:textAppearance="?attr/textAppearanceLabelSmall"
                        android:textColor="@color/text_secondary" />

                    <TextView
                        android:id="@+id/tvInstallmentDate"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="15 Oct 2023"
                        android:textAppearance="?attr/textAppearanceBodyLarge"
                        android:textColor="@color/navy_text_primary"
                        android:textStyle="bold" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginStart="@dimen/spacing_lg">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Installment"
                        android:textAppearance="?attr/textAppearanceLabelSmall"
                        android:textColor="@color/text_secondary" />

                    <TextView
                        android:id="@+id/tvInstallment"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="KSh 4,250.00"
                        android:textAppearance="?attr/textAppearanceBodyLarge"
                        android:textColor="@color/navy_text_primary"
                        android:textStyle="bold" />

                </LinearLayout>

            </LinearLayout>
        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

    <!-- Payment Amount -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_lg"
        android:text="PAYMENT AMOUNT (KSH)"
        android:textAppearance="?attr/textAppearanceLabelSmall"
        android:textColor="@color/navy_text_primary"
        android:textStyle="bold" />

    <com.google.android.material.textfield.TextInputLayout
        style="@style/Widget.TerraLink.TextInputLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_sm">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etPaymentAmount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="numberDecimal"
            android:text="KSh 4250.00"
            android:textStyle="bold"
            android:textColor="@color/navy_text_primary" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- M-Pesa Phone Number -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_lg"
        android:text="M-PESA PHONE NUMBER"
        android:textAppearance="?attr/textAppearanceLabelSmall"
        android:textColor="@color/navy_text_primary"
        android:textStyle="bold" />

    <com.google.android.material.textfield.TextInputLayout
        style="@style/Widget.TerraLink.TextInputLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_sm"
        app:startIconDrawable="@drawable/ic_smartphone"
        app:startIconContentDescription="Phone">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etMpesaPhone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="phone"
            android:text="0712 345 678"
            android:textColor="@color/navy_text_primary" />
    </com.google.android.material.textfield.TextInputLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_sm"
        android:text="A push notification will be sent to this device"
        android:textAppearance="?attr/textAppearanceBodySmall"
        android:textColor="@color/text_muted" />

    <!-- Presets (Full Balance, Installment, Custom) -->
    <com.google.android.material.chip.ChipGroup
        android:id="@+id/chipGroupAmount"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_lg"
        app:singleSelection="true">

        <com.google.android.material.chip.Chip
            android:id="@+id/chipFullBalance"
            style="@style/Widget.Material3.Chip.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Full Balance" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chipInstallment"
            style="@style/Widget.Material3.Chip.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checked="true"
            android:text="Installment" />
    </com.google.android.material.chip.ChipGroup>

    <!-- Pay Now Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnPayMpesa"
        style="@style/Widget.TerraLink.Button.Primary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_lg"
        android:text="Pay Now"
        app:icon="@drawable/ic_banknote" />

</LinearLayout>
