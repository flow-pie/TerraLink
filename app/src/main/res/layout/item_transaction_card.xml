<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/Widget.TerraLink.Card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="@dimen/card_padding">

        <FrameLayout
            android:id="@+id/iconContainer"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:background="@drawable/bg_circle_terracotta"
            android:padding="12dp">

            <ImageView
                android:id="@+id/ivTxIcon"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/ic_wallet"
                app:tint="@color/terracotta_primary" />

        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvTxTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Loan Repayment"
                android:textAppearance="?attr/textAppearanceTitleMedium"
                android:textColor="@color/navy_text_primary"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvTxRef"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Ref: QK7891230"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:textColor="@color/text_secondary" />

            <TextView
                android:id="@+id/tvTxDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="12 Oct 2023 • 14:32"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textColor="@color/text_muted" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvTxAmount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="KES 4,250.00"
                android:textAppearance="?attr/textAppearanceTitleMedium"
                android:textColor="@color/navy_text_primary"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvTxStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_pill_success"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:text="Paid"
                android:textAppearance="?attr/textAppearanceLabelSmall"
                android:textColor="@color/status_green"
                android:textStyle="bold" />
        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
